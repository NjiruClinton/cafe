<main class="min-h-screen bg-stone-50 text-stone-950">
  <header class="border-b border-stone-200 bg-white">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <.link navigate={~p"/"} class="text-sm font-bold uppercase tracking-wide text-stone-950">
        CafeOps
      </.link>
      <div class="flex items-center gap-4 text-sm font-medium text-stone-700">
        <.link navigate={~p"/ops"} class="hover:text-stone-950">Operations</.link>
        <.link navigate={~p"/orders"} class="hover:text-stone-950">Orders</.link>
      </div>
    </nav>
  </header>
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>

<section class="mx-auto max-w-5xl px-6 py-16">
  <p class="text-sm font-semibold uppercase tracking-wide text-amber-700">CafeOps</p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-stone-950 sm:text-5xl">
    Real-time operations for a busy coffee bar.
  </h1>
  <p class="mt-6 max-w-2xl text-lg leading-8 text-stone-700">
    Manage menu availability, track ingredients, and keep orders moving from the counter
    to the bar without leaving Phoenix.
  </p>
  <div class="mt-10 flex gap-3">
    <.link
      navigate={~p"/ops"}
      class="rounded-md bg-stone-950 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-stone-800"
    >
      Open operations board
    </.link>
    <.link
      navigate={~p"/orders"}
      class="rounded-md border border-stone-300 px-4 py-2.5 text-sm font-semibold text-stone-900 hover:bg-stone-50"
    >
      Start an order
    </.link>
  </div>
</section>
